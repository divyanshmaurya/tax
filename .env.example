# Alien Tax Advisory — environment variables
# Copy this file to ".env.local" and fill in the value(s) below.

# Required for the AI assistant (the /assistant chatbot). Get a FREE key from
# Google AI Studio: https://aistudio.google.com/apikey
# The rest of the site (intake, Form 8843 PDF generation, guide) works without it.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-2.5-flash).
# Other options: gemini-2.5-pro (most capable), gemini-2.5-flash-lite (cheapest).
# GEMINI_MODEL=gemini-2.5-flash
